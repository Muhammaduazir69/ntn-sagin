+/// Per-report round robin of the shared uplink, one pass after another, one order per satellite. Every device with
+/// a backlog listens to the satellite the policy picks for it; each satellite grants one report per device in
+/// increasing device index, starting after the device it served last, until its credit runs out. The pointer
+/// survives between ticks and passes, so no index is favored. Queues stay down outside a grant, so an update
+/// generated between two ticks waits for the next one (at most one tick).
+void
+ServeUplinkRoundRobin()
+{
+    const uint32_t S = g_sats.size();
+    std::vector<std::vector<uint32_t>> heard(S);
+    for (uint32_t d = 0; d < g_dev.size(); ++d) // increasing d, so each list is sorted
+    {
+        if (g_devQ[d]->GetInCustody() == 0 || (g_upBudget > 0 && g_devUsed[d] >= g_upBudget))
+        {
+            continue;
+        }
+        const int k = ChooseSatellite(d);
+        if (k >= 0)
+        {
+            heard[k].push_back(d);
+        }
+    }
+    for (uint32_t k = 0; k < S; ++k)
+    {
+        const auto& ds = heard[k];
+        if (ds.empty())
+        {
+            continue;
+        }
+        std::size_t pos = std::lower_bound(ds.begin(), ds.end(), g_rrNext[k]) - ds.begin();
+        std::size_t idle = 0; // consecutive devices that had nothing to send
+        while (g_upCredit[k] >= 1.0 && idle < ds.size())
+        {
+            const uint32_t d = ds[pos % ds.size()];
+            ++pos;
+            if (g_devQ[d]->GetInCustody() == 0)
+            {
+                ++idle;
+                continue;
+            }
+            g_rrGrant = d;
+            const uint64_t before = g_devQ[d]->GetInCustody();
+            g_devQ[d]->SetContactUp(true); // drains one report; the next forward is refused
+            g_devQ[d]->SetContactUp(false);
+            g_rrGrant = -1;
+            g_rrNext[k] = d + 1;
+            idle = g_devQ[d]->GetInCustody() < before ? 0 : idle + 1; // a refusal must not spin here
+        }
+    }
+}
